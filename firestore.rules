rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Match users documents
    match /users/{userId} {
      allow read, write: if true;
    }

    // Match tasks documents
    match /tasks/{taskId} {
      allow read, write: if true;
    }

    // Global Safety Net default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
